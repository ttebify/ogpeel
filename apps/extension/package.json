{
  "name": "@ogpeel/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Save any page's share image. Full size, one click.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt -b edge",
    "dev:chrome": "wxt",
    "build": "wxt build",
    "build:e2e": "OGPEEL_E2E=1 wxt build --mode development",
    "zip": "wxt zip",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs",
    "postinstall": "wxt prepare",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "preact": "^11.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@ogpeel/license": "workspace:*",
    "@ogpeel/pricing": "workspace:*",
    "@ogpeel/theme": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2"
  }
}
