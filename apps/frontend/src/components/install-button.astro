---
// The page is static, so it renders for Chrome and the script below switches it to Edge or Safari.
import BrowserIcon from '@/components/browser-icon.astro';
import { LINKS } from '@/config';

const browsers = [
  { id: 'chrome', label: 'Add to Chrome', href: LINKS.chrome },
  { id: 'edge', label: 'Add to Edge', href: LINKS.edge },
  { id: 'safari', label: 'Get for Safari', href: LINKS.safari },
] as const;
const main =
  'box-border flex min-h-13 items-center gap-3 bg-primary [&[hidden]]:hidden px-6 font-mono text-sm font-medium tracking-label text-primary-foreground uppercase no-underline rule border-border';
---

<div data-install class="relative inline-flex shadow-offset">
  {browsers.map((b, i) => (
    <a data-browser={b.id} href={b.href} class={main} hidden={i !== 0}>
      <BrowserIcon browser={b.id} />
      {b.label}
    </a>
  ))}
  <details class="group">
    <summary
      aria-label="Other browsers"
      class="box-border flex min-h-13 cursor-pointer list-none items-center bg-primary px-4 text-primary-foreground rule-y rule-r border-border [&::-webkit-details-marker]:hidden"
    >
      <svg
        viewBox="0 0 12 12"
        class="size-3 transition-transform group-open:rotate-180"
        aria-hidden="true"
      >
        <path
          d="M1.5 4l4.5 4.5L10.5 4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
        ></path>
      </svg>
    </summary>
    <ul class="absolute top-full left-0 z-10 m-0 mt-2 min-w-full list-none bg-card p-0 rule border-border shadow-offset">
      <li class="mono px-4 pt-3 pb-2 text-xs text-muted-foreground">Other browsers</li>
      {browsers.map((b, i) => (
        <li data-browser={b.id} hidden={i === 0}>
          <a
            href={b.href}
            class="flex min-h-12 items-center gap-3 px-4 font-mono text-sm tracking-label uppercase no-underline rule-t border-border hover:bg-muted"
          >
            <BrowserIcon browser={b.id} />
            {b.label}
          </a>
        </li>
      ))}
    </ul>
  </details>
</div>

<script>
  const ua = navigator.userAgent;
  const current = /Edg\//.test(ua)
    ? 'edge'
    : /Safari\//.test(ua) && !/Chrome|Chromium|CriOS|Edg|OPR|Firefox|FxiOS/.test(ua)
      ? 'safari'
      : 'chrome';

  for (const box of document.querySelectorAll<HTMLElement>('[data-install]')) {
    for (const el of box.querySelectorAll<HTMLElement>('a[data-browser]'))
      el.hidden = el.dataset.browser !== current;
    for (const el of box.querySelectorAll<HTMLElement>('li[data-browser]'))
      el.hidden = el.dataset.browser === current;

    const menu = box.querySelector('details')!;
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      menu.querySelector('summary')!.focus();
    });
  }
</script>
