---
// The product video, as a local poster with a play link. Nothing loads from YouTube until it is
// pressed: the link opens YouTube without JavaScript, and with it the player replaces the poster.
import { VIDEO } from '@/config';
---

<figure class="m-0">
  <div
    data-video={VIDEO.id}
    class="relative aspect-video bg-foreground rule border-border shadow-block"
  >
    <img
      src="/product-video-poster.jpg"
      width="1280"
      height="720"
      alt=""
      loading="lazy"
      class="block size-full object-cover opacity-90"
    />
    <a
      href={`https://www.youtube.com/watch?v=${VIDEO.id}`}
      class="absolute top-1/2 left-1/2 flex min-h-12 -translate-x-1/2 -translate-y-1/2 items-center gap-3.5 bg-foreground px-5 font-mono whitespace-nowrap sm:min-h-16 sm:px-7 text-sm font-medium tracking-label text-background uppercase no-underline rule border-border shadow-[3px_3px_0_var(--background)]"
    >
      <svg viewBox="0 0 16 16" class="size-4 shrink-0" aria-hidden="true">
        <path d="M3 1.5v13l11-6.5z" fill="currentColor"></path>
      </svg>
      Play the video <span class="sr-only">({VIDEO.length})</span>
    </a>
  </div>
  <figcaption class="mono mt-5 flex flex-wrap justify-between gap-x-6 gap-y-2 text-xs">
    <span>Ogpeel · save the picture behind a link</span>
    <span>Loads from YouTube only when you press play</span>
  </figcaption>
</figure>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-video]')) {
    box.querySelector('a')?.addEventListener('click', (event) => {
      event.preventDefault();
      const player = document.createElement('iframe');
      player.src = `https://www.youtube-nocookie.com/embed/${box.dataset.video}?autoplay=1&rel=0`;
      player.title = 'Ogpeel product video';
      player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      player.className = 'block size-full';
      box.replaceChildren(player);
      player.focus();
    });
  }
</script>
