---
import Layout from '@/layouts/layout.astro';
import Wordmark from '@/components/wordmark.astro';
import ButtonLink from '@/components/button-link.astro';
import Dot from '@/components/dot.astro';
import InstallButton from '@/components/install-button';
import ProductVideo from '@/components/product-video';
import { COFFEE, PRICE, REFUND_DAYS } from '@ogpeel/pricing';
import { LINKS } from '@/config';

const wrap = 'mx-auto box-border max-w-site px-6';
const section = 'py-24 rule-t border-border';
const h2 = 'm-0 text-h2 font-semibold leading-h2 tracking-h2';

const steps = [
  ['01', 'Open a page', 'An article, a product page, a news story.'],
  ['02', 'Click Ogpeel', 'See its link preview image, size and format.'],
  ['03', 'Download or copy', 'Save the full-size file, or paste it anywhere.'],
];
const free = [
  'Download the link preview image, full size',
  'Copy the image or its link',
  'See every preview image a page offers',
  'Preview a link on X, LinkedIn, Slack and WhatsApp',
  'Reads a page only when you click Ogpeel',
];
const faq = [
  [
    'Does Ogpeel read the pages I visit?',
    'Only the page you click the icon on, and only at that moment. Nothing is sent anywhere.',
  ],
  [
    'Can I use images I download?',
    'The image still belongs to whoever made it. Ask the site before you reuse it.',
  ],
  [
    `What do I get for ${PRICE}?`,
    'Unlimited developer prompts. Saving and copying images is always free.',
  ],
  [
    'I lost my key.',
    'Search your email for “Your Ogpeel key”. Can’t find it? Write from the address you paid with and a person sends it again.',
  ],
  ['Can I get a refund?', `Yes, within ${REFUND_DAYS} days of paying. Reply to your key email.`],
];
const prompt = `Build link preview images (Open Graph) for the pages of my Next.js site.
Size: 1200 × 630, PNG.
Match the reference layout, but use my own colours, fonts and words.
Set og:image, og:image:width, og:image:height and og:image:alt on each page.`;
---

<Layout
  title="Ogpeel. Save the image in a link preview"
  description="A free browser extension that saves the image you see when someone shares a link. Full size, named after the page."
>
  <a
    href="#main"
    class="mono sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-card focus:p-3"
  >
    Skip to content
  </a>
  <header
    class:list={[
      wrap,
      'flex flex-wrap items-center justify-between gap-4 pt-6 pb-4 border-b-4 border-double border-border',
    ]}
  >
    <Wordmark href="#top" />
    <nav aria-label="Main" class="mono flex flex-wrap items-center gap-6">
      <a href="#how">How it works</a>
      <a href="#developers">Developers</a>
      <a href="#pricing">Pricing</a>
      <a href="/privacy">Privacy</a>
      <ButtonLink variant="solid" size="compact" href="#install">
        Add to browser
      </ButtonLink>
    </nav>
  </header>

  <main id="main">
    <section id="top" class:list={[wrap, 'pt-10 pb-24']} aria-labelledby="hero-title">
      <div class="mono flex flex-wrap justify-between gap-x-6 gap-y-2 pb-3 rule-b border-border">
        <span>A free browser extension</span>
        <span>Chrome · Edge · Safari</span>
      </div>
      <div class="mx-auto max-w-hero pt-10 text-center">
        <h1 id="hero-title" class="m-0 text-hero font-semibold leading-hero tracking-hero">
          Save the image in a link preview
          <Dot />
        </h1>
        <p class="mx-auto mt-6 mb-0 max-w-lead text-2xl italic leading-lead">
          The picture you see when someone shares a link in a chat. Open the page, click Ogpeel, and
          download it full size or copy it to paste anywhere.
        </p>
        <div id="install" class="mt-8 flex justify-center text-left">
          <InstallButton client:load />
        </div>
      </div>
      <div class="mt-12">
        <ProductVideo client:visible />
      </div>
    </section>

    <section id="how" class={section} aria-labelledby="how-title">
      <div class={wrap}>
        <h2 id="how-title" class="mono m-0 mb-8 font-normal">
          How it works
        </h2>
        <ol class="cols m-0 list-none p-0 rule-t border-border">
          {steps.map(([n, title, text], i) => (
            <li
              class:list={[
                'pt-6',
                i === 0 && 'pr-6 border-r border-border',
                i === 1 && 'px-6 border-r border-border',
                i === 2 && 'pl-6',
                'max-[888px]:px-0 max-[888px]:border-r-0 max-[888px]:border-b',
              ]}
            >
              <div class="mono" aria-hidden="true">
                {n}
              </div>
              <h3 class="mt-3 mb-0 text-3xl font-semibold leading-heading">{title}</h3>
              <p class="my-[18px] text-lg leading-body">{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section
      data-look="night"
      class="bg-background py-24 text-foreground"
      aria-labelledby="free-title"
    >
      <div class:list={[wrap, 'cols gap-12']}>
        <div>
          <p class="mono m-0 mb-6">Free, for everyone</p>
          <h2 id="free-title" class={h2}>
            No account. No catch
            <Dot />
          </h2>
        </div>
        <ul class="m-0 list-none p-0 text-xl leading-list rule-t border-border">
          {free.map((item) => (
            <li class="py-4 border-b border-border">{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="developers" class={section} aria-labelledby="dev-title">
      <div class:list={[wrap, 'cols items-center gap-12']}>
        <div>
          <p class="mono m-0 mb-6">For developers</p>
          <h2 id="dev-title" class={h2}>
            Like a site's preview image? Get one in its style
            <Dot />
          </h2>
          <p class="mt-6 mb-0 max-w-copy text-xl leading-snug">
            Ogpeel writes a prompt you paste into your coding agent. It asks for preview images in
            that style for your pages, with your own words and colours.
          </p>
        </div>
        <pre
          aria-label="Example prompt"
          class="m-0 whitespace-pre-wrap bg-card p-6 font-mono text-code leading-code rule border-border shadow-block"
        >{prompt}</pre>
      </div>
    </section>

    <section id="pricing" class={section} aria-labelledby="pricing-title">
      <div class={wrap}>
        <p class="mono m-0 mb-6">Pricing</p>
        <h2 id="pricing-title" class:list={[h2, 'mb-12']}>
          Two prompts free. Then pay once
          <Dot />
        </h2>
        <div class="cols rule border-border">
          <div class="flex flex-col gap-4 p-8 rule-r border-border">
            <h3 class="mono m-0 font-normal">Ogpeel</h3>
            <p class="m-0 text-stat font-semibold leading-none">$0</p>
            <p class="m-0 text-lg leading-body">
              Download, copy and preview images. Plus 2 developer prompts.
            </p>
            <ButtonLink class="mt-auto" href="#install">
              Add to browser
            </ButtonLink>
          </div>
          <div class="flex flex-col gap-4 bg-card p-8">
            <h3 class="mono m-0 font-normal">Unlimited prompts</h3>
            <p class="m-0 text-stat font-semibold leading-none">
              {PRICE} <span class="text-xl font-normal italic">once</span>
            </p>
            <p class="m-0 text-lg leading-body">
              Optional. Only for developer prompts. Your key comes by email, no account. Refund
              within {REFUND_DAYS} days.
            </p>
            <ButtonLink variant="action" class="mt-auto" href={LINKS.checkout}>
              Pay {PRICE} — secure checkout
            </ButtonLink>
            <span class="mono text-xs text-muted-foreground">Checkout by Bachs</span>
          </div>
        </div>
        <div
          id="coffee"
          class="mt-8 flex flex-wrap items-center justify-between gap-6 py-6 rule-y border-border"
        >
          <p class="m-0 text-2xl italic">Don't need prompts but like Ogpeel?</p>
          <ButtonLink variant="solid" href={LINKS.coffee}>
            Buy me a coffee · {COFFEE}
          </ButtonLink>
        </div>
      </div>
    </section>

    <section class={section} aria-labelledby="faq-title">
      <div class:list={[wrap, 'cols gap-12']}>
        <div>
          <p class="mono m-0 mb-6">Questions</p>
          <h2 id="faq-title" class={h2}>
            Common questions
            <Dot />
          </h2>
        </div>
        <div class="flex-[2_1_480px] rule-t border-border">
          {faq.map(([q, a], i) => (
            <details name="faq" open={i === 0} class="group rule-b border-border">
              <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 text-intro font-semibold [&::-webkit-details-marker]:hidden">
                <span>{q}</span>
                <span class="mono" aria-hidden="true">
                  <span class="group-open:hidden">+</span>
                  <span class="hidden group-open:inline">−</span>
                </span>
              </summary>
              <p class="mt-0 mb-6 max-w-answer text-lg leading-body">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t-4 border-double border-border">
    <div class:list={[wrap, 'mono flex flex-wrap justify-between gap-6 pt-6 pb-12 text-xs']}>
      <span>Ogpeel · made by Justice Ekemezie</span>
      <nav aria-label="Footer" class="flex flex-wrap gap-6">
        <a href="/privacy">Privacy</a>
        <a href="/key">Find my key</a>
        <a href="#coffee">Buy me a coffee</a>
        <a href="#top">Back to top ↑</a>
      </nav>
    </div>
  </footer>
</Layout>
