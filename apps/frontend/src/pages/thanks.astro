---
import { REFUND_DAYS } from '@ogpeel/pricing';
import Layout from '@/layouts/layout.astro';
import PageHeader from '@/components/page-header.astro';
import Dot from '@/components/dot.astro';

const steps = [
  'Click Ogpeel, then the Settings gear.',
  'Choose Enter key, paste your key and click Unlock prompts.',
  'Use the same key on any browser you work in.',
];
---

<Layout title="Thank you · Ogpeel" description="How to get and use your Ogpeel key.">
  <meta name="robots" content="noindex" slot="head" />
  <div class="min-h-[900px]">
    <PageHeader rule="column" />
    <main class="mx-auto box-border max-w-header px-6 pt-16 pb-24">
      <h1 class="mt-0 mb-0 text-thanks font-semibold leading-page tracking-hero">
        Thank you for buying Ogpeel
        <Dot />
      </h1>

      <div class="mt-12 bg-card p-6 rule border-border shadow-block">
        <p class="mono m-0">Check your inbox</p>
        <p class="mt-3 mb-0 text-xl leading-snug">
          After payment, your key is emailed to the address you paid with, under the subject “Your
          Ogpeel key”. Look in spam too. No email? <a href="/key">Get help</a>.
        </p>
      </div>

      <h2 class="mono mt-16 mb-4 font-normal">Unlock Ogpeel</h2>
      <ol class="m-0 list-none p-0 rule-t border-border">
        {steps.map((step, i) => (
          <li class="flex gap-6 py-4 text-xl border-b border-border">
            <span class="mono" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {step}
          </li>
        ))}
      </ol>
      <p class="mono mt-12 text-xs text-muted-foreground">
        Changed your mind? Reply to the key email within {REFUND_DAYS} days of paying for a full
        refund.
      </p>
    </main>
  </div>
</Layout>
