---
import { PRICE, REFUND_DAYS } from '@ogpeel/pricing';
import Layout from '@/layouts/layout.astro';
import PageHeader from '@/components/page-header.astro';
import Dot from '@/components/dot.astro';

const steps = [
  'Click the Ogpeel icon, then “Make one like this for your site”.',
  'Choose “I have a key” and paste it.',
  'Use the same key on any browser you work in.',
];
---
<Layout title="Thank you · Ogpeel" description="Your Ogpeel key is on its way, and how to use it.">
  <meta name="robots" content="noindex" slot="head" />
  <div class="min-h-[900px]">
    <PageHeader rule="column" />
    <main class="mx-auto box-border max-w-header px-6 pt-16 pb-24">
      <p class="mono m-0">✓ Payment received · {PRICE}</p>
      <h1 class="mt-4 mb-0 text-thanks font-semibold leading-page tracking-hero">Thank you. Your key is on its way<Dot /></h1>

      <div class="mt-12 bg-card p-6 rule border-border shadow-block">
        <p class="mono m-0">Check your inbox</p>
        <p class="mt-3 mb-0 text-xl leading-snug">We sent it to the email you paid with, under the subject “Your Ogpeel key”. It can take a minute; look in spam too.</p>
      </div>

      <h2 class="mono mt-16 mb-4 font-normal">Unlock Ogpeel</h2>
      <ol class="m-0 list-none p-0 rule-t border-border">
        {steps.map((step, i) => (
          <li class="flex gap-6 py-4 text-xl border-b border-border"><span class="mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{step}</li>
        ))}
      </ol>
      <p class="mono mt-12 text-xs text-muted-foreground">Changed your mind? Reply to the receipt within {REFUND_DAYS} days for a full refund.</p>
    </main>
  </div>
</Layout>
