{
  "name": "ogpeel-worker",
  "main": "src/index.ts",
  "routes": [
    { "pattern": "api.ogpeel.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-11-01",
  "vars": {
    "BACHS_API_URL": "https://api.bachs.io",
    // The "Unlimited prompts" product. Empty = no product yet: no key is ever sent.
    "BACHS_PRODUCT_ID": "",
    // Where Bachs sends the buyer after paying.
    "SUCCESS_URL": "https://ogpeel.com/thanks",
    // Must be an address on a domain verified with Resend.
    "MAIL_FROM": "Ogpeel <hello@ogpeel.com>"
  }
  // Secrets, set with `wrangler secret put <NAME>` (locally: .dev.vars):
  // BACHS_SECRET_KEY, BACHS_WEBHOOK_SECRET, LICENSE_PRIVATE_KEY, RESEND_API_KEY
}
